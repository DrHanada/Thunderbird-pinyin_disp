{
  "manifest_version": 2,
  "name": "Thunderbird Pinyin Display",
  "version": "0.1.0",
  "description": "メール本文で選択した簡体字中国語のピンインを表示します。",
  "permissions": ["messagesModify"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-pinyin-display@drhanada",
      "strict_min_version": "128.0"
    }
  }
}
