{
  "manifest_version": 2,
  "name": "Thunderbird Pinyin Display",
  "version": "0.1.0",
  "description": "Displays pinyin for selected Simplified Chinese text in email messages.",
  "permissions": ["messagesModify"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-pinyin-display@drhanada",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
